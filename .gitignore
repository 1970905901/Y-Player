# 内嵌 Node 运行时（nodejs-mobile）按需下载，不入库：
# 解压后 device 54.9 MB + simulator fat 115.4 MB，用脚本按 sha256 取同一个产物。
ThirdParty/nodejs-mobile/
ThirdParty/.cache/

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# === Xcode / SwiftPM ===
# 工程由 XcodeGen 从 project.yml 生成，不入库
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
# Info.plist 同样由 XcodeGen 的 info: 段生成
Apps/*/Info.plist
xcuserdata/
*.xcuserstate
*.moved-aside
DerivedData/
build/
.build/
.swiftpm/
Package.resolved
*.swiftmodule
*.xcframework
!ThirdParty/xcframeworks/**
*.dSYM
*.dSYM.zip
*.ipa
*.app
*.dmg
Payload/

# === 本仓库产出的中间物 ===
Tools/.cache/
Tools/out/
ThirdParty/downloads/
ThirdParty/maven/
analysis/

# === 依赖 / 工具 ===
node_modules/
Pods/
vendor/
.env
.env.*

# === 其它 ===
*.log
*.tmp
!.gitkeep
